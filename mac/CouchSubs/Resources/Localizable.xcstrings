    },
    "Open CouchSubs": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open CouchSubs"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CouchSubs'ı aç"
          }
        }
      }
    },
    "Game packs": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game packs"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun paketleri"
          }
        }
      }
    },
    "Use game packs": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use game packs"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun paketlerini kullan"
          }
        }
      }
    },
    "Ready-made Turkish translations for some games. A line found in a pack appears at once, without the translation engine.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready-made Turkish translations for some games. A line found in a pack appears at once, without the translation engine."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı oyunlar için hazır Türkçe çeviriler. Pakette bulunan satır, çeviri motoruna gitmeden hemen görünür."
          }
        }
      }
    },
    "No game pack is installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No game pack is installed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü oyun paketi yok."
          }
        }
      }
    },
    "%1$@ · %2$@ lines": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ lines"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ satır"
          }
        }
      }
    },
    "Send the English subtitles read to the shared pool": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the English subtitles read to the shared pool"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunan İngilizce altyazıları ortak havuza gönder"
          }
        }
      }
    },
    "Only the game's English text is sent, anonymously. It is used to make better Turkish translations for everyone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the game's English text is sent, anonymously. It is used to make better Turkish translations for everyone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız oyunun İngilizce metni anonim olarak gönderilir. Herkes için daha iyi Türkçe çeviriler hazırlamakta kullanılır."
          }
        }
      }
    },
    "CouchSubs sends the English subtitles it reads to a shared pool, anonymously, to make better Turkish translations for everyone. You can turn this off in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CouchSubs sends the English subtitles it reads to a shared pool, anonymously, to make better Turkish translations for everyone. You can turn this off in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CouchSubs, okuduğu İngilizce altyazıları anonim olarak ortak havuza gönderir; böylece herkes için daha iyi Türkçe çeviriler hazırlanır. Ayarlar'dan kapatabilirsiniz."
          }
        }
      }
    },
    "No PS5 found. Make sure it is on and on the same network, or enter its IP address. CouchSubs must also be allowed in System Settings › Privacy & Security › Local Network.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No PS5 found. Make sure it is on and on the same network, or enter its IP address. CouchSubs must also be allowed in System Settings › Privacy & Security › Local Network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 bulunamadı. Açık ve aynı ağda olduğundan emin olun ya da IP adresini girin. CouchSubs'ın Sistem Ayarları › Gizlilik ve Güvenlik › Yerel Ağ'da da açık olması gerekir."
          }
        }
      }
    },
    "Connecting to the PS5… This can take up to 30 seconds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to the PS5… This can take up to 30 seconds."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'e bağlanılıyor… Bu 30 saniye kadar sürebilir."
          }
        }
      }
    },
    "The code is wrong or has expired. Open Pair Device again on the PS5 and enter the new code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is wrong or has expired. Open Pair Device again on the PS5 and enter the new code."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod yanlış ya da süresi dolmuş. PS5'te Cihazı Eşleştir'i yeniden açın ve yeni kodu girin."
          }
        }
      }
    },
    "The PS5 received the request but did not answer in time. Open Pair Device again on the PS5 and enter the new code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PS5 received the request but did not answer in time. Open Pair Device again on the PS5 and enter the new code."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 isteği aldı ama zamanında yanıt vermedi. PS5'te Cihazı Eşleştir'i yeniden açın ve yeni kodu girin."
          }
        }
      }
    },
    "No PS5 found at this address. Check the PS5's IP address under Settings › Network › Connection Status.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No PS5 found at this address. Check the PS5's IP address under Settings › Network › Connection Status."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adreste PS5 bulunamadı. PS5'in IP adresini Ayarlar › Ağ › Bağlantı Durumu'ndan kontrol edin."
          }
        }
      }
    },
    "macOS blocked the connection to the local network. Turn on CouchSubs in System Settings › Privacy & Security › Local Network, then enter a new code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blocked the connection to the local network. Turn on CouchSubs in System Settings › Privacy & Security › Local Network, then enter a new code."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS yerel ağ bağlantısını engelledi. Sistem Ayarları › Gizlilik ve Güvenlik › Yerel Ağ'da CouchSubs'ı açın, sonra yeni kodu girin."
          }
        }
      }
    },
    "If this keeps happening, send us this file: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this keeps happening, send us this file: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorun sürerse şu dosyayı bize gönderin: %@"
          }
        }
      }
    },
    "Show log file": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show log file"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük dosyasını göster"
          }
        }
      }
    },
    "Sony did not complete the sign-in. Wait a minute, then press Sign in again and sign in with the second account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony did not complete the sign-in. Wait a minute, then press Sign in again and sign in with the second account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony girişi tamamlamadı. Bir dakika bekleyin, sonra Giriş yap'a yeniden basıp ikinci hesapla giriş yapın."
          }
        }
      }
    },
    "Sony received too many sign-in attempts. Wait about 15 minutes, then sign in again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony received too many sign-in attempts. Wait about 15 minutes, then sign in again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony çok fazla giriş denemesi aldı. Yaklaşık 15 dakika bekleyip yeniden giriş yapın."
          }
        }
      }
    },
    "Sony's sign-in server returned an error. Wait a few minutes, then sign in again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony's sign-in server returned an error. Wait a few minutes, then sign in again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony'nin giriş sunucusu hata verdi. Birkaç dakika bekleyip yeniden giriş yapın."
          }
        }
      }
    },
    "Could not reach Sony's sign-in server. Check the internet connection, then sign in again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach Sony's sign-in server. Check the internet connection, then sign in again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony'nin giriş sunucusuna ulaşılamadı. İnternet bağlantısını kontrol edip yeniden giriş yapın."
          }
        }
      }
    },
    "Sony's answer could not be read. Sign in again; if it keeps happening, update CouchSubs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony's answer could not be read. Sign in again; if it keeps happening, update CouchSubs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony'nin yanıtı okunamadı. Yeniden giriş yapın; sürerse CouchSubs'ı güncelleyin."
          }
        }
      }
    },
    "The sign-in window was closed before sign-in finished. Press Sign in and finish signing in in the window.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in window was closed before sign-in finished. Press Sign in and finish signing in in the window."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş penceresi giriş bitmeden kapandı. Giriş yap'a basıp girişi pencerede tamamlayın."
          }
        }
      }
    },
    "Sony's sign-in page could not be loaded. Check the internet connection, then sign in again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony's sign-in page could not be loaded. Check the internet connection, then sign in again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sony'nin giriş sayfası açılamadı. İnternet bağlantısını kontrol edip yeniden giriş yapın."
          }
        }
      }
    },
    "Paired with %@. Connects when you start translating.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired with %@. Connects when you start translating."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ile eşleşti. Çeviriyi başlatınca bağlanır."
          }
        }
      }
    },
    "PS5 not found at %@. Make sure it is on and on the same network. Reconnecting…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 not found at %@. Make sure it is on and on the same network. Reconnecting…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 %@ adresinde bulunamadı. Açık ve aynı ağda olduğundan emin olun. Yeniden bağlanılıyor…"
          }
        }
      }
    },
    "Can't reach the PS5. Reconnecting…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the PS5. Reconnecting…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5'e ulaşılamıyor. Yeniden bağlanılıyor…"
          }
        }
      }
    },
    "Reconnecting… (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnecting… (%@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden bağlanılıyor… (%@)"
          }
        }
      }
    },
    "Picture mode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture mode"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü modu"
          }
        }
      }
    },
    "Inside the app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inside the app"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama içinde"
          }
        }
      }
    },
    "Overlay (for a black screen)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlay (for a black screen)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katman (siyah ekran sorunu için)"
          }
        }
      }
    },
    "If the PS5 picture stays black inside the CouchSubs TV app, choose Overlay: the TV shows the PS5 on its own HDMI input and the subtitles appear on top. If the picture never arrives, the TV app switches to Overlay by itself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the PS5 picture stays black inside the CouchSubs TV app, choose Overlay: the TV shows the PS5 on its own HDMI input and the subtitles appear on top. If the picture never arrives, the TV app switches to Overlay by itself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 görüntüsü CouchSubs TV uygulamasının içinde siyah kalıyorsa Katman'ı seçin: TV, PS5'i kendi HDMI girişinde gösterir, altyazı görüntünün üstünde çıkar. Görüntü hiç gelmezse TV uygulaması kendiliğinden Katman'a geçer."
          }
        }
      }
    },
    "Copy the link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the link"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyı kopyala"
          }
        }
      }
    },
    "Details:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıntı:"
          }
        }
      }
    },
    "If the TV shows “Server under maintenance”, it cannot reach Samsung's servers: check the TV's internet connection and its date and time, restart the TV and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the TV shows “Server under maintenance”, it cannot reach Samsung's servers: check the TV's internet connection and its date and time, restart the TV and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de “Sunucu bakım altında” yazıyorsa TV, Samsung'un sunucularına ulaşamıyor: TV'nin internet bağlantısını, tarih ve saatini kontrol edin, TV'yi yeniden başlatıp tekrar deneyin."
          }
        }
      }
    },
    "A CouchSubs TV app signed on another computer is still on the TV and could not be removed. On the TV, open Apps, select CouchSubs, delete it and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A CouchSubs TV app signed on another computer is still on the TV and could not be removed. On the TV, open Apps, select CouchSubs, delete it and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de başka bir bilgisayarda imzalanmış bir CouchSubs uygulaması var ve kaldırılamadı. TV'de Uygulamalar'ı açın, CouchSubs'ı seçip silin ve tekrar deneyin."
          }
        }
      }
    },
    "The TV did not accept the signing certificate. Make sure the TV is connected to the internet (it checks the certificate with Samsung) and its date and time are right (Settings › General › System Manager › Time), then try again. CouchSubs gets a new certificate, so you sign in to Samsung once more.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV did not accept the signing certificate. Make sure the TV is connected to the internet (it checks the certificate with Samsung) and its date and time are right (Settings › General › System Manager › Time), then try again. CouchSubs gets a new certificate, so you sign in to Samsung once more."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV imza sertifikasını kabul etmedi. TV'nin internete bağlı olduğundan (sertifikayı Samsung'a sorar) ve tarih ile saatinin doğru olduğundan emin olun (Ayarlar › Genel › Sistem Yöneticisi › Saat), sonra tekrar deneyin. CouchSubs yeni sertifika alacağı için Samsung hesabınızla bir kez daha giriş yaparsınız."
          }
        }
      }
    },
    "The TV's clock is behind, so the new certificate is not valid for it yet. Set the TV's date and time (Settings › General › System Manager › Time) or wait a few minutes, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV's clock is behind, so the new certificate is not valid for it yet. Set the TV's date and time (Settings › General › System Manager › Time) or wait a few minutes, then try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'nin saati geride olduğu için yeni sertifika TV'ye göre henüz geçerli değil. TV'nin tarih ve saatini düzeltin (Ayarlar › Genel › Sistem Yöneticisi › Saat) ya da birkaç dakika bekleyip tekrar deneyin."
          }
        }
      }
    },
    "The TV refuses CouchSubs because an earlier CouchSubs is still registered on it (Tizen error 118, -22), even if it no longer appears among the apps. If CouchSubs is among the TV's apps, delete it there and try again. Otherwise reset Smart Hub (Settings › Support › Device Care › Self Diagnosis › Reset Smart Hub; menu names differ a little by model) and try again. Resetting Smart Hub also removes the other apps you downloaded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV refuses CouchSubs because an earlier CouchSubs is still registered on it (Tizen error 118, -22), even if it no longer appears among the apps. If CouchSubs is among the TV's apps, delete it there and try again. Otherwise reset Smart Hub (Settings › Support › Device Care › Self Diagnosis › Reset Smart Hub; menu names differ a little by model) and try again. Resetting Smart Hub also removes the other apps you downloaded."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV, daha önceki bir CouchSubs'ın kaydı hâlâ durduğu için uygulamayı kabul etmiyor (Tizen hatası 118, -22); uygulama listede görünmese de. CouchSubs TV'nin uygulamaları arasındaysa oradan silip tekrar deneyin. Değilse Smart Hub'ı sıfırlayıp (Ayarlar › Destek › Cihaz Bakımı › Kendi Kendine Tanılama › Smart Hub'ı Sıfırla; menü adları modele göre biraz değişir) tekrar deneyin. Smart Hub'ı sıfırlamak, indirdiğiniz diğer uygulamaları da kaldırır."
          }
        }
      }
    },
    "The connection to the TV dropped during the install. Keep the TV on and on the same network as this computer, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to the TV dropped during the install. Keep the TV on and on the same network as this computer, then try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulum sırasında TV bağlantısı koptu. TV'yi açık ve bu bilgisayarla aynı ağda tutup tekrar deneyin."
          }
        }
      }
    },
    "1. On the TV, open Apps and scroll to the very bottom of the page.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. On the TV, open Apps and scroll to the very bottom of the page."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. TV'de Uygulamalar ekranını açın ve sayfanın en altına inin."
          }
        }
      }
    },
    "2. There, press 1 2 3 4 5 on the remote (or type 12345 on the on-screen keypad). The Developer Mode window opens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. There, press 1 2 3 4 5 on the remote (or type 12345 on the on-screen keypad). The Developer Mode window opens."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Orada kumandada 1 2 3 4 5 tuşlarına basın (ya da ekran klavyesiyle 12345 yazın). Geliştirici modu penceresi açılır."
          }
        }
      }
    },
    "The Samsung account page opened in your browser. Finish signing in there. If you do not see it, switch to the browser or press Open the page again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Samsung account page opened in your browser. Finish signing in there. If you do not see it, switch to the browser or press Open the page again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung hesabı penceresi tarayıcıda açıldı, girişi orada tamamlayın. Göremiyorsanız tarayıcıya geçin ya da Sayfayı yeniden aç'a basın."
          }
        }
      }
    },
    "Samsung signs the app for your TV with your free Samsung account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung signs the app for your TV with your free Samsung account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung, uygulamayı ücretsiz Samsung hesabınızla TV'nize özel imzalar."
          }
        }
      }
    },
    "Accept the permission box on the TV with the remote (Allow). CouchSubs waits 60 seconds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept the permission box on the TV with the remote (Allow). CouchSubs waits 60 seconds."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'de çıkan izin kutusunu kumandayla onaylayın (İzin ver). CouchSubs 60 saniye bekler."
          }
        }
      }
    },
    "The TV's permission box was not accepted within 60 seconds. If no box appeared, open the TV's home screen and press Connect again. If CouchSubs was denied before, allow it in Settings › General › External Device Manager › Device Connection Manager › Device List.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV's permission box was not accepted within 60 seconds. If no box appeared, open the TV's home screen and press Connect again. If CouchSubs was denied before, allow it in Settings › General › External Device Manager › Device Connection Manager › Device List."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV'deki izin kutusu 60 saniye içinde onaylanmadı. Kutu hiç çıkmadıysa TV'de ana ekranı açıp yeniden Bağlan'a basın. CouchSubs'a daha önce izin verilmediyse Ayarlar › Genel › Harici Aygıt Yöneticisi › Cihaz Bağlantı Yöneticisi › Cihaz Listesi'nden izin verin."
          }
        }
      }
    },
    "The TV refused the connection. Allow CouchSubs in Settings › General › External Device Manager › Device Connection Manager › Device List on the TV, then press Connect again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TV refused the connection. Allow CouchSubs in Settings › General › External Device Manager › Device Connection Manager › Device List on the TV, then press Connect again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV bağlantıyı reddetti. TV'de Ayarlar › Genel › Harici Aygıt Yöneticisi › Cihaz Bağlantı Yöneticisi › Cihaz Listesi'nden CouchSubs'a izin verip yeniden Bağlan'a basın."
          }
        }
      }
    },
