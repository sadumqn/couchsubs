+/**
+ * Whether a corrupt frame report may be sent now: always, except while waiting for a requested IDR frame,
+ * where it is limited to one every VIDEO_CORRUPT_REPORT_INTERVAL_MS. Only called from the Takion thread.
+ */
+static bool video_receiver_corrupt_report_due(ChiakiVideoReceiver *video_receiver)
+{
+	uint64_t now_ms = chiaki_time_now_monotonic_ms();
+	if(chiaki_video_receiver_get_waiting_for_idr(video_receiver)
+		&& now_ms - video_receiver->corrupt_report_last_ms < VIDEO_CORRUPT_REPORT_INTERVAL_MS)
+		return false;
+	video_receiver->corrupt_report_last_ms = now_ms;
+	video_receiver->stats.corrupt_reports++;
+	return true;
+}
+
+/**
+ * Called once for every new frame. Every VIDEO_STATS_INTERVAL_MS, if anything went wrong since the last time,
+ * one log line says what: it tells a lossy network (FEC failed), a console that doesn't answer IDR requests
+ * (skipped, no IDR received) and a decoder that refuses frames apart. "delivered" frames went to the video
+ * callback. Silent while the stream is healthy.
+ */
+static void video_receiver_stats_frame(ChiakiVideoReceiver *video_receiver)
+{
+	uint64_t now_ms = chiaki_time_now_monotonic_ms();
+	if(!video_receiver->stats.since_ms)
+		video_receiver->stats.since_ms = now_ms;
+	uint64_t elapsed_ms = now_ms - video_receiver->stats.since_ms;
+	if(elapsed_ms >= VIDEO_STATS_INTERVAL_MS)
+	{
+		// also after a gap without any frame: the next frame reports how long nothing arrived
+		if(video_receiver->stats.delivered < video_receiver->stats.frames || video_receiver->stats.corrupt_reports
+			|| video_receiver->stats.idr_requests || elapsed_ms >= 2 * VIDEO_STATS_INTERVAL_MS)
+		{
+			CHIAKI_LOGI(video_receiver->log, "Video in the last %u ms: %u frames, %u delivered, %u FEC failed, %u skipped waiting for IDR, "
+				"%u missing reference, %u refused by decoder, %u corrupt reports, %u IDR requests, %u IDR received%s",
+				(unsigned int)elapsed_ms,
+				(unsigned int)video_receiver->stats.frames, (unsigned int)video_receiver->stats.delivered,
+				(unsigned int)video_receiver->stats.fec_failed, (unsigned int)video_receiver->stats.skipped,
+				(unsigned int)video_receiver->stats.missing_reference, (unsigned int)video_receiver->stats.refused,
+				(unsigned int)video_receiver->stats.corrupt_reports, (unsigned int)video_receiver->stats.idr_requests,
+				(unsigned int)video_receiver->stats.idr_received,
+				chiaki_video_receiver_get_waiting_for_idr(video_receiver) ? ", still waiting for IDR" : "");
+		}
+		memset(&video_receiver->stats, 0, sizeof(video_receiver->stats));
+		video_receiver->stats.since_ms = now_ms;
+	}
+	video_receiver->stats.frames++;
+}
