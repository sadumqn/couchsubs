<!-- Yalnız masaüstünün ADB ile kurduğu APK: katman modu (bkz. OverlayService). Google Play paketinde yoktur; Play'in TV
     kalite kuralı TV-TR başka uygulamaların üstünü örtmeye izin vermiyor (docs/play-store-tv.md). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Katman modu: altyazı TV'nin kendi HDMI ekranının üstünde. İzni bilgisayar ADB ile verir. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application>
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Subtitle overlay on top of the TV's own HDMI input" />
        </service>
    </application>
</manifest>
