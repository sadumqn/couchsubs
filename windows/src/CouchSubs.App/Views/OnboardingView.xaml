<!-- Kurulum sihirbazı (Mac WizardView, Perde): üstte logo, ortada ilerleme noktaları (şimdiki adım amber hap), sağda "Sonra
     Ayarlarım"; içerik alanı yanlarda 120, üstte 24, altta 40; adım etiketi ("Adım 3 / 4", "Kurulum · Hesap"), başlık,
     açıklama, adım; altta solda Geri (ikincil) ve Deneme modu, sağda adımın kısa notu ve tek ana düğme Devam. Üst çubuk ve
     alttaki Geri / Devam çubuğu cam katman: adım içeriği ikisinin de arkasından kayar. Kurulumda reklam yok. -->
<UserControl x:Class="CouchSubs.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme"
             xmlns:local="clr-namespace:CouchSubs.App.Views">
    <Grid>
        <!-- Ortam ışığı (Perde; hareket kapısına bağlı, çok yavaş). Kabuğun içindeyken kabuğun kendi ortam ışığı görünür, bu gizlenir. -->
        <c:AmbientGlow x:Name="Ambient" Intensity="0.7" />

        <!-- Adım içeriği pencere boyu kayar; ilk açılışta çubukların arasında başlar, en alttaki içerik kaydırınca tam görünür. -->
        <ScrollViewer x:Name="StepScroll" Style="{StaticResource CardScroll}">
            <Border Padding="{DynamicResource wizard.inset}">
                <StackPanel Margin="{t:Sp 'wizardSide,l,wizardSide,0'}">
                    <TextBlock x:Name="Counter" Style="{StaticResource EyebrowText}" Margin="{t:Sp '0,0,0,xs'}" />
                    <ContentControl x:Name="StepHost" Focusable="False" Margin="{t:Sp '0,0,xs,0'}" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Cam çubuklar (e3): yarı saydam koyu degrade, tıklamayı geçirir. -->
        <Border VerticalAlignment="Top" Height="{DynamicResource shell.topGlass}" Background="{DynamicResource glassBarBrush}" IsHitTestVisible="False" />
        <Border VerticalAlignment="Bottom" Height="{DynamicResource wizard.bottomGlass}" Background="{DynamicResource glassBarBottomBrush}" IsHitTestVisible="False" />

        <Grid VerticalAlignment="Top" Height="{DynamicResource size.titleBarHeight}" Margin="{t:Sp 'l,0'}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <c:CouchLogo />
                <TextBlock Text="CouchSubs" FontWeight="Bold" FontSize="15" Margin="{t:Sp 's,0,0,0'}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="Dots" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" />
            <Button x:Name="LaterButton" Grid.Column="2" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    FontSize="{DynamicResource smallFontSize}"
                    Content="{t:T 'I\'ll Set Up Later'}" Click="OnLater" />
        </Grid>

        <DockPanel VerticalAlignment="Bottom" Margin="{t:Sp 'wizardSide,0,wizardSide,xxl'}">
            <Button x:Name="BackButton" Content="{t:T 'Back'}" Style="{StaticResource SecondaryButton}" Margin="{t:Sp '0,0,m,0'}" Click="OnBack" />
            <!-- Her adımda: konsolu olmayan, uygulamayı örnek görüntülerle dener. -->
            <local:DemoModeButton ButtonStyle="GhostButton" VerticalAlignment="Center" />
            <Button Content="{t:T 'Reset setup'}" Style="{StaticResource GhostButton}" Margin="{t:Sp 'xs,0,0,0'}"
                    Visibility="{Binding ConsoleKindLocked, Converter={StaticResource VisibleIf}}" Click="OnReset" />
            <Button x:Name="ContinueButton" DockPanel.Dock="Right" Content="{t:T 'Continue'}" Style="{StaticResource WidePrimaryButton}" IsDefault="True"
                    IsEnabled="{Binding CanAdvance}" Click="OnContinue" />
            <!-- Adımın kısa notu (Mac WizardText.footnote): sağda, Devam'ın solunda, en çok iki satır. -->
            <TextBlock x:Name="Footnote" DockPanel.Dock="Right" Style="{StaticResource FootnoteText}" Margin="{t:Sp 's,0,m,0'}" />
            <Border />
        </DockPanel>
    </Grid>
</UserControl>
