<Window x:Class="CouchSubs.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CouchSubs.App.Controls"
        xmlns:s="clr-namespace:CouchSubs.App.Views.Steps"
        xmlns:t="clr-namespace:CouchSubs.App.Theme"
        xmlns:local="clr-namespace:CouchSubs.App.Views"
        Title="{t:T 'Settings'}" Width="600" Height="720" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource backgroundBrush}" Foreground="{DynamicResource textPrimaryBrush}">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{t:T 'Settings'}" Style="{StaticResource TitleText}" Margin="32,24,32,12" />
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource surfaceBrush}" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,1,0,0" Padding="32,16">
            <Button Content="{t:T 'Done'}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="OnDone" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,0,32,24">
                <c:Card Title="{t:T 'On the TV'}">
                    <StackPanel>
                        <TextBlock Text="{t:T 'Text size'}" Margin="0,0,0,8" />
                        <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Small" Content="{t:T 'Small'}" GroupName="size" Style="{StaticResource SegmentButton}" Checked="OnSize" Tag="36" />
                                <RadioButton x:Name="Medium" Content="{t:T 'Medium'}" GroupName="size" Style="{StaticResource SegmentButton}" Checked="OnSize" Tag="46" />
                                <RadioButton x:Name="Large" Content="{t:T 'Large'}" GroupName="size" Style="{StaticResource SegmentButton}" Checked="OnSize" Tag="58" />
                                <RadioButton x:Name="ExtraLarge" Content="{t:T 'Extra large'}" GroupName="size" Style="{StaticResource SegmentButton}" Checked="OnSize" Tag="72" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{t:T 'Placement'}" Margin="0,0,0,8" />
                        <ComboBox x:Name="Placement" SelectionChanged="OnPlacement" Margin="0,0,0,8">
                            <ComboBoxItem Content="{t:T 'Over the English subtitle'}" Tag="Cover" />
                            <ComboBoxItem Content="{t:T 'Above the English subtitle'}" Tag="Above" />
                            <ComboBoxItem Content="{t:T 'Below the English subtitle'}" Tag="Below" />
                            <ComboBoxItem Content="{t:T 'Fixed position'}" Tag="Fixed" />
                        </ComboBox>
                        <TextBlock x:Name="FollowsHint" Style="{StaticResource HintText}" Margin="0,0,0,16"
                                   Text="{t:T 'The translation follows where the game shows its own subtitle.'}" />
                        <StackPanel x:Name="FixedPanel">
                        <TextBlock Text="{t:T 'Position on screen'}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{t:T 'Bottom'}" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                            <!-- Sürüklerken TV'de örnek altyazı görünür; böylece yer doğrudan ekranda ayarlanır. -->
                            <Slider x:Name="Position" Grid.Column="1" Minimum="0" Maximum="85" Margin="12,0" IsMoveToPointEnabled="True"
                                    ValueChanged="OnPosition" PreviewMouseDown="OnPositionStart" />
                            <TextBlock Grid.Column="2" Text="{t:T 'Top'}" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,16"
                                   Text="{t:T 'In fixed position you can also move subtitles with the ▲ and ▼ buttons on the TV remote.'}" />
                        </StackPanel>
                        <TextBlock Text="{t:T 'Background'}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{t:T 'None'}" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                            <Slider x:Name="BackgroundOpacity" Grid.Column="1" Minimum="0" Maximum="100" Margin="12,0" IsMoveToPointEnabled="True"
                                    ValueChanged="OnBackground" PreviewMouseDown="OnPositionStart" />
                            <TextBlock Grid.Column="2" Text="{t:T 'Solid'}" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                        </Grid>
                        <CheckBox x:Name="Bold" Content="{t:T 'Bold text'}" Foreground="{DynamicResource textPrimaryBrush}" Margin="0,0,0,16"
                                  Checked="OnBold" Unchecked="OnBold" />
                        <Button Content="{t:T 'Send test subtitle'}" Click="OnTest" />
                    </StackPanel>
                </c:Card>

                <local:DubbingCard x:Name="Dubbing" Margin="0,16,0,0" />

                <c:Card x:Name="LanguageCard" Title="{t:T 'Language'}" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{t:T 'Game language'}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <ComboBox x:Name="GameLanguage" SelectionChanged="OnLanguage" />
                    </StackPanel>
                </c:Card>

                <c:Card Title="{t:T 'Subtitle area'}" Margin="0,16,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,12" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{t:T 'Subtitles'}" GroupName="area" Style="{StaticResource SegmentButton}" Checked="OnArea" Tag="0" IsChecked="True" />
                                <RadioButton Content="{t:T 'Area 2 (F8)'}" GroupName="area" Style="{StaticResource SegmentButton}" Checked="OnArea" Tag="1" />
                                <RadioButton Content="{t:T 'Area 3 (F9)'}" GroupName="area" Style="{StaticResource SegmentButton}" Checked="OnArea" Tag="2" />
                            </StackPanel>
                        </Border>
                        <CheckBox x:Name="UseArea" Content="{t:T 'Use this area'}" Foreground="{DynamicResource textPrimaryBrush}" Margin="0,0,0,12"
                                  Visibility="Collapsed" Checked="OnUseArea" Unchecked="OnUseArea" />
                        <c:RegionPicker x:Name="Region" RegionChanged="OnRegion" />
                        <TextBlock x:Name="AreaHint" Style="{StaticResource HintText}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </c:Card>

                <s:TvAppCard Margin="0,16,0,0" />

                <c:Card Margin="0,16,0,0">
                    <Grid>
                        <Button Content="{t:T 'About CouchSubs'}" Click="OnAbout" />
                        <Button Content="{t:T 'Set up again…'}" HorizontalAlignment="Right" Foreground="{DynamicResource dangerBrush}" Click="OnReset" />
                    </Grid>
                </c:Card>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
