<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mac uygulamasıyla ortak tek kaynaklar: tasarım değerleri ve metinler. -->
    <EmbeddedResource Include="..\..\..\design\tokens.json" LogicalName="tokens.json" />
    <EmbeddedResource Include="..\..\..\core\Sources\CouchSubsCore\Resources\obs-overlay.html" LogicalName="obs-overlay.html" />
    <EmbeddedResource Include="..\..\..\core\Sources\CouchSubsCore\Resources\glossary-en-tr.json" LogicalName="glossary-en-tr.json" />
    <EmbeddedResource Include="..\..\..\core\Sources\CouchSubsCore\Resources\ai-models.json" LogicalName="ai-models.json" />
    <!-- Oyun çeviri paketleri: Mac ile aynı klasör (ad: "packs/x.json.gz"). -->
    <EmbeddedResource Include="..\..\..\core\Sources\CouchSubsCore\Resources\packs\*.json.gz" LogicalName="packs/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\mac\CouchSubs\Resources\Localizable.xcstrings" LogicalName="Localizable.xcstrings" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Paket imzasının (PackFuzzy) iç adımları Mac ve betikle aynı mı: ortak deneme verisiyle sınanır. -->
    <InternalsVisibleTo Include="CouchSubs.Core.Tests" />
    <InternalsVisibleTo Include="CouchSubs.Translation.Tests" />
  </ItemGroup>

</Project>
