// iPhone/iPad uygulamasının ayarları. Gerçek değerler Secrets.xcconfig'te (gitignore'da; örnek: Secrets.xcconfig.example).
// Boş kalan her değer ilgili özelliği kapatır; uygulama yine derlenir ve çalışır.

// RevenueCat'in Apple SDK anahtarı (appl_...). Boşsa ödeme ekranı "yakında" der.
REVENUECAT_API_KEY =
// Paket sunucusu (server/packs, Cloudflare Worker). "//" xcconfig'te yorum olduğu için https:/$()/... yazılır.
PACKS_API_BASE_URL =
// Meta (Facebook) uygulama kimliği ve istemci jetonu. Boşsa Meta SDK kurulmaz.
FACEBOOK_APP_ID =
FACEBOOK_CLIENT_TOKEN =
// GoogleService-Info.plist'teki REVERSED_CLIENT_ID (Google ile giriş dönüşü).
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.not-configured
// AdMob uygulama kimliği. Varsayılan Google'ın deneme kimliğidir; reklam zaten Remote Config ile kapalı.
GAD_APPLICATION_ID = ca-app-pub-3940256099942544~1458002511

#include? "Secrets.xcconfig"
